---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Banner from '@/components/Banner.astro'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/henahax.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
			integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<script src="https://static.tsviewer.com/short_expire/js/ts3viewer_loader.js"></script>
		<ClientRouter />
	</head>
	<body class="flex min-h-dvh flex-col">
		<app
			class="flex w-full max-w-4xl grow flex-col content-center justify-center gap-8 self-center p-4"
		>
			<Banner isLayout={true} />
			<slot />
		</app>
		<footer class="w-full flex items-end">
			
			<div class="marquee">
				<div class="marquee-track">
					<span>© 2026 henahax.net</span>
					<span>Servers</span>
					<span>Gaming</span>
					<span>Projects</span>
				</div>
			</div>
				
			<a id="source" class="flex gap-2 items-center text-center px-2 py-4 rounded-tl-lg border border-neutral-500 text-xs" href="https://github.com/henahax/homepage">
			<i class="fa-brands fa-github"></i>
				Source
		</a>
		</footer>
	</body>
	<style is:global>
		@view-transition {
			navigation: auto;
		}

		:root {
			--primary: var(--color-teal-500);
			--foreground: var(--color-neutral-950);
			--background: var(--color-neutral-700);
		}

		body {
			position: relative;
			font-family: Consolas, monaco, monospace;
			background-color: var(--background);
		}

		.card-shape {
			border-radius: 1rem 0.5rem 1rem 0.5rem;
		}

		.tilt {
			transform: skew(-5deg) rotate(-5deg);
		}

		.tilt-shadow {
			box-shadow: 0.5rem 0.5rem 0 black;
			animation: shadow-move 2s infinite ease-in-out;
		}

		@keyframes shadow-move {
			0% {
				box-shadow: 0.5rem 0.5rem 0 black;
			}
			50% {
				box-shadow: 0.75rem 0.75rem 0 black;
			}
			100% {
				box-shadow: 0.5rem 0.5rem 0 black;
			}
		}

		.marquee {
  			overflow: hidden;
  			white-space: nowrap;
  			width: 100%;
  			padding: 0.5rem 0;
			color: var(--foreground);
			background-color: var(--primary);
			text-transform: uppercase;
		}

		.marquee-track {
  			display: flex;
  			width: max-content;
  			animation: marquee 15s linear infinite;
		}

		.marquee-track span {
  			flex-shrink: 0;
  			padding-right: 4rem; /* Abstand zwischen Wiederholungen */
		}

		@keyframes marquee {
  			from {
    			transform: translateX(0%);
  			}
  			to {
    			transform: translateX(-50%);
  			}
		}

		footer a#source{
			background-color: var(--foreground);
		}
	</style>
</html>
