---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Banner from '@/components/Banner.astro'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/henahax.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
			integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<script src="https://static.tsviewer.com/short_expire/js/ts3viewer_loader.js"></script>
		<ClientRouter />
	</head>
	<body class="flex min-h-dvh flex-col">
		<app
			class="flex w-full max-w-4xl grow flex-col content-center justify-center gap-8 self-center p-4"
		>
			<Banner isLayout={true} />
			<slot />
		</app>
		<footer class="w-full flex items-end">
			
			<div class="marquee">
				<div class="marquee__track">
					<span>© 2026 henahax.net</span>
					<span>Servers</span>
					<span>Gaming</span>
					<span>Projects</span>
					<span aria-hidden="true">© 2026 henahax.net</span>
					<span aria-hidden="true">Servers</span>
					<span aria-hidden="true">Gaming</span>
					<span aria-hidden="true">Projects</span>
					<span aria-hidden="true">© 2026 henahax.net</span>
					<span aria-hidden="true">Servers</span>
					<span aria-hidden="true">Gaming</span>
					<span>Projects</span>
				</div>
			</div>
				
			<a id="source" class="flex gap-4 items-center text-center p-4 rounded-tl-lg border border-neutral-500 text-xs" href="https://github.com/henahax/homepage">
			<i class="fa-brands fa-github"></i>
				Source
		</a>
		</footer>
	</body>
	<style is:global>
		@view-transition {
			navigation: auto;
		}

		:root {
			--foreground: var(--color-neutral-950);
			--background: var(--color-yellow-300);
		}

		.marquee {
  			overflow: hidden;
  			white-space: nowrap;
  			width: 100%;
  			padding: 0.5rem 0;
			color: var(--foreground);
			background-color: var(--background);
		}

		.marquee__track {
  			display: flex;
  			width: max-content;
  			animation: marquee 15s linear infinite;
		}

		.marquee__track span {
  			flex-shrink: 0;
  			padding-right: 4rem; /* Abstand zwischen Wiederholungen */
		}

		@keyframes marquee {
  			from {
    			transform: translateX(0);
  			}
  			to {
    			transform: translateX(-50%);
  			}
		}


		body {
			position: relative;
			font-family: Consolas, monaco, monospace;
			color: var(--color-neutral-200);
			background-color: var(--color-neutral-950);

		}

		a:hover {
			color: white;
		}

		.card {
			border: 1px solid var(--color-neutral-500);
			backdrop-filter: blur(var(--blur-md));
			border-radius: 1.5rem 0.5rem 1.5rem 0.5rem;
		}

		a.card:hover {
			border-color: white;
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.75);
			background-color: rgba(255, 255, 255, 0.05);
		}

		.subcard {
			border-radius: 1.25rem 0.25rem 1.25rem 0.25rem;
		}

		.tag {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			border-radius: calc(infinity * 1px);
			padding: 0 0.75rem;
			background-color: rgba(255, 255, 255, 0.25);
			color: white;
			height: fit-content;
		}
	</style>
</html>
