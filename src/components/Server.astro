---
interface Props {
	connectLink: string
}

const { connectLink } = Astro.props
---

<div
	class="server subcard pulp flex flex-col gap-4 bg-black/30 p-4 text-sm shadow-sm backdrop-blur-sm"
>
	<div class="flex items-center justify-between gap-4 text-lg">
		<div class="flex items-center gap-2">
			<slot name="icon" />
			<slot name="title" />
		</div>
		<a
			href={connectLink}
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-secondary oracle"
		>
			<i class="fa-solid fa-plug"></i>
			<span class="max-sm:hidden">Connect</span>
		</a>
	</div>
	<slot name="content" />
</div>
