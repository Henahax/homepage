---
interface Props {
  connectLink: string;
}

const { connectLink } = Astro.props;
---

<div
  class="card-shape-inner server pulp flex flex-col gap-4 p-4 text-sm shadow-sm bg-black/30 backdrop-blur-sm"
>
  <div class="flex items-center justify-between gap-4 text-lg">
    <div class="flex items-center gap-2">
      <slot name="icon" />
      <slot name="title" />
    </div>
    <a
      href={connectLink}
      target="_blank"
      rel="noopener noreferrer"
      class="link flex items-center gap-2 rounded-full border px-4 py-2 text-sm"
    >
      <i class="fa-solid fa-plug"></i>
      <span class="max-sm:hidden">Connect</span>
    </a>
  </div>
  <slot name="content" />
</div>

<style>
  .server {
    color: var(--background);
    border-radius: 0.75rem;
  }
</style>
