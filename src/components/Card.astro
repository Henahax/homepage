---
interface Props {
  transitionName: string;
}

const { transitionName } = Astro.props;
---

<div class="flex flex-col card-page">
  <a class="card-back" href="/">
    <i class="fa-solid fa-angle-left"></i>
    <div>Back</div>
  </a>

  <div
    class="card-header font-extrabold uppercase flex items-center w-fit"
    transition:name={transitionName}
  >
  <div class="flex items-center gap-4 text-4xl px-8 py-4">
    <slot name="icon" transition:name={transitionName + "-icon"} />

    <slot name="title" transition:name={transitionName + "-title"} />

    <slot name="link" transition:name={transitionName + "-link"} />
    </div>
  </div>

  <div
    class="primary-element card shape tilt-shadow bg-white/5 backdrop-blur-md"
    transition:name={transitionName}
  >
    <div class="card-content">
      <slot name="content" />
    </div>
  </div>
</div>

<style>
  /* ========== PAGE-LEVEL ENTRANCE ========== */
  .card-page {
    animation: pageEntrance 700ms ease-out forwards;
  }

  @keyframes pageEntrance {
    0% {
      opacity: 0;
      translate: 0 30px;
    }
    100% {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ========== HEADER STAGGERED ENTRANCE ========== */
  .card-header > * {
    opacity: 0;
    animation: headerEntrance 600ms ease-out forwards;

    transform: skew(10deg);
  }

  @keyframes headerEntrance {
    0% {
      opacity: 0;
      translate: 0 20px;
      rotate: -6deg;
      scale: 0.9;
    }
    50% {
      opacity: 1;
      translate: 0 -6px;
      rotate: 2deg;
      scale: 1.03;
    }
    70% {
      translate: 0 3px;
      rotate: -1deg;
      scale: 0.99;
    }
    100% {
      opacity: 1;
      translate: 0 0;
      rotate: 0deg;
      scale: 1;
    }
  }

  /* ========== CARD CONTENT ENTRANCE ========== */
  .card {
    opacity: 0;
    animation: cardEntrance 600ms ease-out forwards;
    animation-delay: 200ms;
    will-change: transform, opacity, box-shadow;
    border: 1px var(--secondary);
  }

  @keyframes cardEntrance {
    0% {
      opacity: 0;
      translate: 0 2rem;
      box-shadow: 0 0 0 transparent;
    }
    60% {
      opacity: 1;
      translate: 0 -0.25rem;
      box-shadow: var(--surface-shadow-hover);
    }
    100% {
      opacity: 1;
      translate: 0 0;
      box-shadow: var(--surface-shadow);
    }
  }

  /* ========== CONTENT STAGGER (for direct children) ========== */
  .card-content > * {
    opacity: 0;
    animation: contentEntrance 500ms ease-out forwards;
    animation-delay: calc(300ms + sibling-index() * 60ms);
  }

  @keyframes contentEntrance {
    0% {
      opacity: 0;
      translate: 0 16px;
    }
    100% {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ========== BACK BUTTON ========== */
  .card-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--secondary);
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
    opacity: 0;
    animation: backEntrance 400ms ease-out forwards;
    animation-delay: 40ms;
  }

  @keyframes backEntrance {
    0% {
      opacity: 0;
      translate: -12px 0;
    }
    100% {
      opacity: 1;
      translate: 0 0;
    }
  }

  .card-back:hover,
  .card-back:focus-visible {
    box-shadow: var(--surface-shadow-hover);
    border-color: var(--secondary);
    background-color: color-mix(in srgb, var(--secondary) 12%, transparent);
    outline: none;
  }

  .card-back:active {
    transform: translate(0, 0) scale(0.97);
  }

  /* ========== CARD BASE ========== */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    box-shadow: var(--surface-shadow);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
    border-radius: 1rem;

    border-width: 1px;
    border-color: var(--primary)
  }

  /* ========== HEADER LAYOUT ========== */
  .card-header {
    background-color: var(--primary);
    transform: skew(-10deg) rotate(-1deg) translateY(2rem);
    z-index: 1;
  }

  .card-header-link:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ========== VIEW TRANSITION POLISH ========== */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(root) {
      animation-duration: 400ms;
      animation-timing-function: ease-out;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 400ms;
      animation-timing-function: ease-in-out;
    }
  }

  /* ========== REDUCED MOTION ========== */
  @media (prefers-reduced-motion: reduce) {
    .card-page,
    .card-header > *,
    .card,
    .card-content > *,
    .card-back {
      animation: none !important;
      opacity: 1 !important;
      translate: 0 0 !important;
      rotate: 0deg !important;
      scale: 1 !important;
    }
  }
</style>
