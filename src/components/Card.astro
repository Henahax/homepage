---
interface Props {
	transitionName: string
}

const { transitionName } = Astro.props
---

<div class="flex flex-col">
	<a class="card-back flex items-center gap-2 w-fit p-2 pr-4 rounded-full text-sm" href="/">
		<i class="fa-solid fa-angle-left"></i>
		<div>Back</div>
	</a>

	<div
		class="card-header heading card-title flex w-fit items-center font-extrabold uppercase"
		transition:name={transitionName + '-card'}
	>
		<div class="flex items-center gap-4">
			<slot name="icon" transition:name={transitionName + '-icon'} />
			<slot name="title" transition:name={transitionName + '-title'} />
			<slot name="link" />
		</div>
	</div>

	<div
		class="primary-element card shape tilt-shadow bg-white/5 backdrop-blur-md"
		transition:name={transitionName}
	>
		<div class="card-content">
			<slot name="content" />
		</div>
	</div>
</div>

