---
interface Props {
  transitionName: string;
}

const { transitionName } = Astro.props;
---

<div class="flex flex-col">
  <a class="card-back" href="/">
    <i class="fa-solid fa-angle-left"></i>
    <div>Back</div>
  </a>

  <div class="card card-shape tilt-shadow" transition:name={transitionName}>
    <div class="card-header">
      <slot name="icon" />
      <slot name="title" />
      <slot name="link" />
    </div>
    <div class="card-content">
      <slot name="content" />
    </div>
  </div>
</div>

<style>
  .card-back {
    color: var(--secondary);
  }
</style>
