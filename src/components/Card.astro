---
interface Props {
	transitionName: string
}

const { transitionName } = Astro.props
---

<div class="flex flex-col">
	<a class="flex items-center gap-2 rounded-xl p-2" href="/">
		<i class="fa-solid fa-angle-left"></i>
		<div>Back</div>
	</a>

	<div class="card card-shape tilt-shadow" transition:name={transitionName}>
		<div class="card-header">
				<slot name="icon" />
				<slot name="title" />
			<slot name="link" />
		</div>

		<div class="card-content">
			<slot name="content" />
		</div>
	</div>
</div>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		background: var(--primary-gradient);
		border: 1px solid var(--foreground);
		padding: 0.5rem;
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 1.5rem;
		color: var(--foreground);
		padding: 0 0.5rem;
	}

	.card-content {
	}

	a:hover {
		backdrop-filter: blur(var(--blur-md));
		background-color: rgba(255, 255, 255, 0.05);
	}
</style>
