---
interface Props {
  transitionName: string;
}

const { transitionName } = Astro.props;
---

<div class="flex flex-col">
  <a class="card-back" href="/">
    <i class="fa-solid fa-angle-left"></i>
    <div>Back</div>
  </a>

  <div class="card-header font-extrabold uppercase">
    <div class="card-header-icon">
      <slot name="icon" />
    </div>
    <div class="card-header-title">
      <slot name="title" />
    </div>
    <div class="card-header-link">
      <slot name="link" />
    </div>
  </div>

  <div
    class="primary-element card shape tilt-shadow"
    transition:name={transitionName}
  >
    <div class="card-content">
      <slot name="content" />
    </div>
  </div>
</div>

<style>
  .card-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    color: var(--secondary);
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 999px;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .card-back:hover,
  .card-back:focus-visible {
    transform: translate(-0.125rem, -0.125rem);
    box-shadow: var(--surface-shadow-hover);
    border-color: var(--secondary);
    outline: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    box-shadow: var(--surface-shadow);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);

    background-color: yellow;
    border-radius: 1rem;
  }

  .card-header {
    display: flex;
  }

  .card-header-icon,
  .card-header-title,
  .card-header-link {
    font-size: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-header-icon {
    height: 3.5rem;
    width: 3.5rem;
    transform: translateX(-1rem) translateY(2.5rem) rotate(-15deg);
    border-radius: 100%;
    background-color: red;
    z-index: 99;
  }

  .card-header-title {
    width: fit-content;
    transform: translateX(-2rem) translateY(1rem) rotate(-5deg);
    background-color: blue;
    z-index: 98;
    border-radius: 4rem;
    padding: 0 2rem;
  }

  .card-header-link {
    z-index: 97;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
