---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";

const tiles = [
  {
    name: "server",
    desc: "Servers",
    link: "/servers",
    icon: "fa-solid fa-server",
  },
  {
    name: "gaming",
    desc: "Gaming",
    link: "/gaming",
    icon: "fa-solid fa-gamepad",
  },
  {
    name: "projects",
    desc: "Projects",
    link: "/projects",
    icon: "fa-solid fa-code",
  },
  {
    name: "links",
    desc: "Links",
    link: "/links",
    icon: "fa-solid fa-link",
  },
];
---

<Layout title="henahax.net">
  <div class="flex flex-col items-center justify-center gap-8">
    <Banner isLayout={false} />

    <div
      class="flex flex-col items-center justify-center gap-4 w-full max-w-2xs"
    >
      {
        tiles.map((tile) => (
          <a
            class="card card-shape menu-option border-2"
            href={tile.link}
            transition:name={tile.name}
          >
            <div class="flex items-center gap-4">
              <i class={tile.icon} transition:name={"icon" + tile.name} />
              <div transition:name={"title" + tile.name}>{tile.desc}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .menu-option {
    padding: 1rem 4rem 1rem 4rem;
    transform: skew(-5deg) rotate(-5deg);
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    font-size: 1.5rem;
    border-width: 0.125rem;
    background: var(--primary-gradient);
    color: var(--foreground);
    animation: shadow-move 2s infinite ease-in-out;
  }

  .menu-option:hover,
  .menu-option:focus {
    outline: none;
  }

  .menu-option > div {
    text-transform: uppercase;
    transition: transform 180ms ease-out;
    will-change: transform;
  }

  .menu-option:hover > div,
  .menu-option:focus > div {
    animation: slide 0.35s ease-in-out;
  }

  @keyframes slide {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(0.75rem, -0.15rem);
    }
    100% {
      transform: translate(0, 0);
    }
  }
</style>
