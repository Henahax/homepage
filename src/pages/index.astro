---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";

const tiles = [
  {
    name: "servers",
    icon: "fa-solid fa-server",
  },
  {
    name: "gaming",
    icon: "fa-solid fa-gamepad",
  },
  {
    name: "projects",
    icon: "fa-solid fa-code",
  },
  {
    name: "links",
    icon: "fa-solid fa-link",
  },
];
---

<Layout title="henahax.net">
  <div class="flex flex-col items-center justify-center gap-8">
    <Banner isLayout={false} />

    <div
      class="flex flex-col items-center justify-center gap-4 w-full max-w-2xs"
    >
      {
        tiles.map((tile) => (
          <a
            class="card card-shape menu-option"
            href={"/" + tile.name}
            transition:name={tile.name + "-card"}
          >
            <div>
              <i class={tile.icon} transition:name={tile.name + "-icon"} />
              <div transition:name={tile.name + "-title"}>{tile.name}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
