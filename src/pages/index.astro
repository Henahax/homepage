---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";

const tiles = [
  {
    name: "servers",
    icon: "fa-solid fa-server",
  },
  {
    name: "gaming",
    icon: "fa-solid fa-gamepad",
  },
  {
    name: "projects",
    icon: "fa-solid fa-code",
  },
  {
    name: "links",
    icon: "fa-solid fa-link",
  },
];
---

<Layout title="henahax.net">
  <div class="flex flex-col items-center justify-center gap-8">
    <Banner isLayout={false} />

    <div class="flex flex-col items-start justify-center gap-4">
      {
        tiles.map((tile) => (
          <a
            class="menu-option occult uppercase w-full"
            href={"/" + tile.name}
            transition:name={tile.name + "-card"}
          >
            <div class="flex items-center gap-2">
              <i class={tile.icon} transition:name={tile.name + "-icon"} />
              <div transition:name={tile.name + "-title"}>{tile.name}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .menu-option {
    padding: 0.5rem 1rem;
    background-color: green;
    clip-path: polygon(
      1% 2% /* top-left */,
      98% 0% /* top-right */,
      100% 100% /* bottom-right */,
      0% 94% /* bottom-left */
    );
  }

  .menu-option:hover,
  .menu-option:focus-visible {
  }

  .menu-option:hover,
  .menu-option:focus-visible {
  }

  .menu-option > div {
  }

  .menu-option:hover > div,
  .menu-option:focus-visible > div {
  }
</style>
