---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";

const tiles = [
  {
    name: "Servers",
    link: "servers",
    icon: "fa-solid fa-server",
  },
  {
    name: "Gaming",
    link: "gaming",
    icon: "fa-solid fa-gamepad",
  },
  {
    name: "Projects",
    link: "projects",
    icon: "fa-solid fa-code",
  },
  {
    name: "Links",
    link: "links",
    icon: "fa-solid fa-link",
  },
];
---

<Layout title="henahax.net">
  <div class="flex flex-col items-center justify-center gap-8">
    <Banner isLayout={false} />

    <div class="grid grid-cols-[auto_1fr] gap-4">
      {
        tiles.map((tile) => (
          <a
            class="menu-option shape uppercase pulp text-2xl grid grid-cols-subgrid col-span-full items-center"
            href={"/" + tile.link}
            transition:name={tile.link + "-card"}
          >
            <div class="grid grid-cols-subgrid col-span-full items-center">
              <i class={tile.icon} transition:name={tile.link + "-icon"} />
              <div transition:name={tile.link + "-title"}>{tile.link}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .menu-option {
    padding: 1.25rem 2.5rem;
    background: var(--primary);

    transform: skew(-10deg) rotate(-1deg);
    will-change: transform, opacity;

    /* Entrance */
    opacity: 0;
    animation:
      menu-fade-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) forwards,
      wobble 0.25s ease-in-out forwards;

    animation-delay:
      calc(sibling-index() * 100ms), calc(sibling-index() * 100ms + 500ms);
  }

  .menu-option:hover,
  .menu-option:focus-visible {
    transform: skew(-10deg) scale(1.05);
  }

  .menu-option > * {
    transform: skew(10deg);
  }

  @keyframes menu-fade-in {
    from {
      opacity: 0;
      transform: skew(-10deg) translateY(15px) rotate(-1deg);
    }
    to {
      opacity: 1;
      transform: skew(-10deg) translateY(0) rotate(-1deg);
    }
  }

  @keyframes wobble {
    0% {
      transform: skew(-10deg) rotate(-1deg);
    }
    50% {
      transform: skew(-10deg) rotate(-2.5deg);
    }
    100% {
      transform: skew(-10deg) rotate(-1deg);
    }
  }
</style>
