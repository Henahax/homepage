---
import Layout from '@/layouts/Layout.astro'
import Banner from '@/components/Banner.astro'

const tiles = [
	{
		name: 'Servers',
		link: 'servers',
		icon: 'fa-solid fa-server'
	},
	{
		name: 'Gaming',
		link: 'gaming',
		icon: 'fa-solid fa-gamepad'
	},
	{
		name: 'Projects',
		link: 'projects',
		icon: 'fa-solid fa-code'
	},
	{
		name: 'Links',
		link: 'links',
		icon: 'fa-solid fa-link'
	}
]
---

<Layout title="henahax.net">
	<div class="flex flex-col items-center justify-center gap-8">
		<Banner isLayout={false} />

		<div class="grid grid-cols-[auto_1fr] gap-4">
			{
				tiles.map((tile) => (
					<a
						class="menu-option shape col-span-full grid grid-cols-subgrid items-center text-3xl font-black uppercase"
						href={'/' + tile.link}
						transition:name={tile.link + '-card'}
					>
						<div class="col-span-full grid grid-cols-subgrid items-center">
							<i class={tile.icon} transition:name={tile.link + '-icon'} />
							<div transition:name={tile.link + '-title'}>{tile.link}</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</Layout>

<style>
	.menu-option {
		padding: 1.25rem 2.5rem;
		background: var(--primary);

		transform: skew(-10deg) rotate(-1deg);
		will-change: transform;
		transition-duration: 250ms;

		/* Entrance animation: fade-in + subtle wobble */
		opacity: 0;
		animation: entrance 600ms ease-out forwards;
		animation-delay: calc((sibling-index() - 1) * 80ms);
	}

	@keyframes entrance {
		0% {
			opacity: 0;
			translate: 0 20px;
			rotate: -4deg;
		}
		40% {
			opacity: 1;
			translate: 0 -4px;
			rotate: 1deg;
		}
		60% {
			translate: 0 2px;
			rotate: -0.5deg;
		}
		100% {
			opacity: 1;
			translate: 0 0;
			rotate: 0deg;
		}
	}

	.menu-option:hover,
	.menu-option:focus-visible {
		transform: skew(-10deg) rotate(-1deg) scale(1.05);
	}

	.menu-option > * {
		transform: skew(10deg);
	}

	/* Respect reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.menu-option {
			opacity: 1;
			animation: none;
		}
	}
</style>
