---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";

const tiles = [
  {
    name: "Servers",
    link: "servers",
    icon: "fa-solid fa-server",
  },
  {
    name: "Gaming",
    link: "gaming",
    icon: "fa-solid fa-gamepad",
  },
  {
    name: "Projects",
    link: "projects",
    icon: "fa-solid fa-code",
  },
  {
    name: "Links",
    link: "links",
    icon: "fa-solid fa-link",
  },
];
---

<Layout title="henahax.net">
  <div class="flex flex-col items-center justify-center gap-8">
    <Banner isLayout={false} />

    <div class="grid grid-cols-[auto_1fr] gap-4">
      {
        tiles.map((tile) => (
          <a
            class="menu-option shape uppercase text-3xl grid grid-cols-subgrid col-span-full items-center font-black"
            href={"/" + tile.link}
            transition:name={tile.link + "-card"}
          >
            <div class="grid grid-cols-subgrid col-span-full items-center">
              <i class={tile.icon} transition:name={tile.link + "-icon"} />
              <div transition:name={tile.link + "-title"}>{tile.link}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .menu-option {
    padding: 1.25rem 2.5rem;
    background: var(--primary);

    transform: skew(-10deg) rotate(-1deg);
    will-change: transform;
    transition-duration: 250ms;
  }

  .menu-option:hover,
  .menu-option:focus-visible {
    transform: skew(-10deg) rotate(-1deg) scale(1.05);
  }

  .menu-option > * {
    transform: skew(10deg);
  }
</style>
