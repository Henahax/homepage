---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";

const tiles = [
  {
    name: "servers",
    icon: "fa-solid fa-server",
  },
  {
    name: "gaming",
    icon: "fa-solid fa-gamepad",
  },
  {
    name: "projects",
    icon: "fa-solid fa-code",
  },
  {
    name: "links",
    icon: "fa-solid fa-link",
  },
];
---

<Layout title="henahax.net">
  <div class="flex flex-col items-center justify-center gap-8">
    <Banner isLayout={false} />

    <div
      class="flex flex-col items-center justify-center gap-4 w-full max-w-2xs"
    >
      {
        tiles.map((tile) => (
          <a
            class="card card-shape menu-option"
            href={"/" + tile.name}
            transition:name={tile.name + "-card"}
          >
            <div>
              <i class={tile.icon} transition:name={tile.name + "-icon"} />
              <div transition:name={tile.name + "-title"}>{tile.name}</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .menu-option {
    padding: 1rem 4rem 1rem 4rem;
    transform: skew(-5deg) rotate(-5deg);
    display: flex;
    align-items: center;
    width: 100%;
    font-size: 1.5rem;
    border-width: 0.125rem;
    background: var(--primary-gradient);
    color: var(--foreground);
    animation: shadow-move 2s infinite ease-in-out;
    text-transform: uppercase;
  }

  .menu-option:hover,
  .menu-option:focus {
    outline: none;
  }

  .menu-option > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: transform 180ms ease-out;
    will-change: transform;
  }

  .menu-option:hover > div,
  .menu-option:focus > div {
    animation: slide 0.35s ease-in-out;
  }

  @keyframes slide {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(0.75rem, -0.15rem);
    }
    100% {
      transform: translate(0, 0);
    }
  }
</style>
